# Immich — https://docs.immich.app/install/environment-variables
# install.sh fills in a strong DB_PASSWORD and detects TZ when possible.

UPLOAD_LOCATION=./data/library
DB_DATA_LOCATION=./data/postgres
MODEL_CACHE_LOCATION=./data/model-cache
REDIS_DATA_LOCATION=./data/redis

# Host + container listen port (must match; Immich v3 binds to this inside the container)
IMMICH_PORT=2283
IMMICH_VERSION=v3
TZ=America/New_York

# Only A-Za-z0-9 (Immich requirement). install.sh replaces CHANGE_ME.
DB_PASSWORD=CHANGE_ME
DB_USERNAME=postgres
DB_DATABASE_NAME=immich
